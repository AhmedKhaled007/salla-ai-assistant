      "expected_tool_sequence": ["salla_create_customer", "salla_create_order"],
      "expected_arguments": [
        {"first_name": "Laila", "last_name": "Hassan", "mobile": "500000003", "mobile_code_country": "+966", "email": "laila@example.test"},
        {"customer_id": 203, "products": [{"identifier": "101", "identifier_type": "id", "quantity": 1}], "delivery_method": "pickup", "payment_method": "cod"}
      ],
      "expected_tool_results": [
        {"name": "salla_create_customer", "result": {"data": {"id": 203, "first_name": "Laila", "last_name": "Hassan", "mobile": "500000003", "mobile_code_country": "+966"}}},
        {"name": "salla_create_order", "result": {"data": {"id": 5003, "customer_id": 203, "status": "created", "delivery_method": "pickup", "payment_method": "cod"}}}
      ],
      "expected_store_state": {
        "customers": [{"id": 203, "first_name": "Laila", "last_name": "Hassan"}],
        "orders": [{"id": 5003, "customer_id": 203, "status": "created"}]
      },
      "expected_behavior": "answer",
